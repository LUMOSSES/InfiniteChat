{
  "info": {
    "_postman_id": "6cce0ed5-2150-4cdb-9ea0-7fd5f40f5743",
    "name": "InfiniteChat",
    "description": "Postman collection for the existing InfiniteChat gateway and authentication APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Send Email Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/common/email?email={{email}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "user",
                "common",
                "email"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{email}}"
                }
              ]
            },
            "description": "Send a verification code to the configured email address."
          },
          "response": []
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"code\": \"{{code}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "user",
                "register"
              ]
            },
            "description": "Register a new user with email, password and verification code."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let json;",
                  "try {",
                  "  json = pm.response.json();",
                  "} catch (e) {",
                  "  json = null;",
                  "}",
                  "",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "user",
                "login"
              ]
            },
            "description": "Login with email and password. Saves response token into the collection variable `token`."
          },
          "response": []
        },
        {
          "name": "Login With Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let json;",
                  "try {",
                  "  json = pm.response.json();",
                  "} catch (e) {",
                  "  json = null;",
                  "}",
                  "",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{code}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/loginCode",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "user",
                "loginCode"
              ]
            },
            "description": "Login with email verification code. Saves response token into the collection variable `token`."
          },
          "response": []
        },
        {
          "name": "Update Avatar",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"avatarUrl\": \"{{avatarUrl}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/avatar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "user",
                "avatar"
              ]
            },
            "description": "Update the current user's avatar. Requires the JWT token in the Authorization header."
          },
          "response": []
        },
        {
          "name": "Get Upload URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/common/uploadUrl?fileName={{fileName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "user",
                "common",
                "uploadUrl"
              ],
              "query": [
                {
                  "key": "fileName",
                  "value": "{{fileName}}"
                }
              ]
            },
            "description": "Generate upload and download URLs for a file."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:10010",
      "type": "string"
    },
    {
      "key": "email",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "123456",
      "type": "string"
    },
    {
      "key": "code",
      "value": "123456",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "avatarUrl",
      "value": "http://localhost:9000/infinite-chat/avatar.png",
      "type": "string"
    },
    {
      "key": "fileName",
      "value": "avatar.png",
      "type": "string"
    }
  ]
}
