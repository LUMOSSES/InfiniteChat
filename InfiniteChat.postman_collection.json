  "item": [
    {
      "name": "1. AuthenticationService",
      "description": "认证服务：注册、登录、验证码、头像、上传地址",
      "item": [
        {
          "name": "Send Email Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"code=200\", () => pm.expect(json.code).to.eql(200));",
                  "pm.test(\"email returned\", () => pm.expect(json.data.email).to.eql(pm.collectionVariables.get(\"email\")));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/common/email?email={{email}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "common", "email"],
              "query": [{ "key": "email", "value": "{{email}}" }]
            }
          },
          "response": []
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"code\": \"{{code}}\",\n  \"userName\": \"{{userName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"code=200\", () => pm.expect(json.code).to.eql(200));",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.collectionVariables.set('loginUserId', json.data.userId);",
                  "  console.log('Token saved:', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Login With Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.collectionVariables.set('loginUserId', json.data.userId);",
                  "  console.log('Token saved:', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{code}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/loginCode",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "user", "loginCode"]
            }
          },
          "response": []
        },
        {
          "name": "Update Avatar",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "{{token}}" }
